# This is the env for the local development only
# Dev Environment
ENVIRONMENT=local
# For the vercel deployment, uvicorn will run server on port 8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auto_buyer
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001/api

# JWT
JWT_SECRET=change-this-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#leads-inbox
SLACK_ENABLED=true

# Slack Workflow Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_WORKFLOW_WEBHOOK_URL=https://hooks.slack.com/workflows/YOUR/WORKFLOW/URL
SLACK_WORKFLOW_STEP_ID=your-workflow-step-id
SLACK_WORKFLOW_ENABLED=true

# Database connection pool settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_RECYCLE_SECONDS=3600
DB_POOL_TIMEOUT_SECONDS=30

# Vercel Blob ReadWrite Token
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token
BLOB_STORE_URL=https://gpexrawcpgyvsn1r.public.blob.vercel-storage.com

# OpenAI integration
OPENAI_API_KEY=your_openai_api_key_here

# GCP Storage
GCP_BUCKET_NAME=
GCP_PROJECT_ID=
GCP_CREDENTIALS_JSON=
GCP_STORAGE_ENABLED=true

# Twilio Configuration (for calls and SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=true
# IMPORTANT: For A2P 10DLC compliance (required for business SMS in US)
# Create a Messaging Service in Twilio Console: https://console.twilio.com/us1/develop/sms/services
# 1. Create a Messaging Service
# 2. Add your phone number to the Messaging Service
# 3. Register your 10DLC Brand and Campaign at https://console.twilio.com/us1/develop/sms/regulatory-compliance/ten-dlc
# 4. Link your Campaign to the Messaging Service
# This prevents SMS from being filtered as spam
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio API Key for browser-based voice (optional)
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=